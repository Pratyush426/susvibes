# Kimi Code CLI — environment variables for the native binary
# (replaces the deprecated MOONSHOT_API_KEY / KIMI_API_KEY / KIMI_MODEL used by the old Python kimi-cli)
KIMI_MODEL_NAME="kimi-k2.7-code"
KIMI_MODEL_API_KEY="your-moonshot-api-key"
# Optional: override the API base URL (leave blank to use the Moonshot default)
KIMI_MODEL_BASE_URL=""
# Suppress the first-run trust prompt inside containers
KIMI_CODE_TRUST_WORKSPACE=1
